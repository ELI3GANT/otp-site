{
  "version": 2,
  "cleanUrls": false,
  "ignoreCommand": "node scripts/vercel_ignore_build_step.js",
  "git": {
    "deploymentEnabled": false
  },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "*.js",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.gif",
          "*.svg",
          "*.webp",
          "*.ico",
          "*.webmanifest",
          "*.xml",
          "*.txt",
          "*.mp3",
          "assets/**",
          "components/**",
          "supabase/migrations/**",
          "weatheros/**",
          "evehalo/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "^/fixline/?$",
      "dest": "https://otp-fixline.vercel.app/"
    },
    {
      "src": "^/fixline/intake/?$",
      "dest": "https://otp-fixline.vercel.app/fixline/intake"
    },
    {
      "src": "^/fixline/api/review/submit/?$",
      "dest": "https://otp-fixline.vercel.app/api/review/submit"
    },
    {
      "src": "^/fixline/api/events/?$",
      "dest": "https://otp-fixline.vercel.app/api/events"
    },
    {
      "src": "^/fixline/(privacy|terms|contact)/?$",
      "dest": "https://otp-fixline.vercel.app/fixline/$1"
    },
    {
      "src": "^/fixline/status/([^/]+)/?$",
      "dest": "https://otp-fixline.vercel.app/fixline/status/$1"
    },
    {
      "src": "^/fixline/review-result/([^/]+)/?$",
      "dest": "https://otp-fixline.vercel.app/fixline/review-result/$1"
    },
    {
      "src": "^/fixline/_next/(.*)$",
      "dest": "https://otp-fixline.vercel.app/_next/$1"
    },
    {
      "src": "^/fixline/otp-logo-animated\\.gif$",
      "dest": "https://otp-fixline.vercel.app/otp-logo-animated.gif"
    },
    {
      "src": "^/fixline/favicon\\.ico$",
      "dest": "https://otp-fixline.vercel.app/fixline/favicon.ico"
    },
    {
      "src": "^/fixline/(.*)$",
      "dest": "https://otp-fixline.vercel.app/fixline/$1"
    },
    {
      "src": "^/os/?$",
      "dest": "/server.js"
    },
    {
      "src": "^/os/(.*)$",
      "dest": "/server.js"
    },
    {
      "src": "^/archive\\.html$",
      "status": 308,
      "headers": {
        "Location": "/archive"
      }
    },
    {
      "src": "^/songwars\\.html$",
      "status": 308,
      "headers": {
        "Location": "/songwars"
      }
    },
    {
      "src": "^/(?:consultant-audit\\.html|consultant-audit)/?$",
      "status": 308,
      "headers": {
        "Location": "/services/consultant-audit"
      }
    },
    {
      "src": "^/protocol\\.html$",
      "status": 308,
      "headers": {
        "Location": "/protocol"
      }
    },
    {
      "src": "^/signal\\.html$",
      "status": 308,
      "headers": {
        "Location": "/signal"
      }
    },
    {
      "src": "^/floorops\\.html$",
      "status": 308,
      "headers": {
        "Location": "/floorops"
      }
    },
    {
      "src": "^/images/demo/(.*)$",
      "dest": "https://otp-floorops.vercel.app/images/demo/$1"
    },
    {
      "src": "^/images/warehouse/(.*)$",
      "dest": "https://otp-floorops.vercel.app/images/warehouse/$1"
    },
    {
      "src": "^/_next/(.*)$",
      "dest": "https://otp-floorops.vercel.app/_next/$1"
    },
    {
      "src": "^/floorops/?$",
      "dest": "/floorops.html"
    },
    {
      "src": "^/floorops/demo/?$",
      "dest": "https://otp-floorops.vercel.app/demo"
    },
    {
      "src": "^/floorops/pricing/?$",
      "dest": "https://otp-floorops.vercel.app/pricing"
    },
    {
      "src": "^/floorops/request-demo/?$",
      "dest": "https://otp-floorops.vercel.app/request-demo"
    },
    {
      "src": "^/floorops/contact/?$",
      "dest": "https://otp-floorops.vercel.app/contact"
    },
    {
      "src": "^/floorops/api/(.*)$",
      "dest": "https://otp-floorops.vercel.app/api/$1"
    },
    {
      "src": "^/floorops/_next/(.*)$",
      "dest": "https://otp-floorops.vercel.app/_next/$1"
    },
    {
      "src": "^/floorops/login/?$",
      "status": 307,
      "headers": {
        "Location": "https://otp-floorops.vercel.app/login"
      }
    },
    {
      "src": "^/floorops/join/?$",
      "status": 307,
      "headers": {
        "Location": "https://otp-floorops.vercel.app/join"
      }
    },
    {
      "src": "^/floorops/app/?$",
      "status": 307,
      "headers": {
        "Location": "https://otp-floorops.vercel.app/app"
      }
    },
    {
      "src": "^/floorops/app/(.*)$",
      "status": 307,
      "headers": {
        "Location": "https://otp-floorops.vercel.app/app/$1"
      }
    },
    {
      "src": "^/floorops/(.*)$",
      "dest": "https://otp-floorops.vercel.app/$1"
    },
    {
      "src": "^/weatheros\\.html$",
      "status": 308,
      "headers": {
        "Location": "/weatheros"
      }
    },
    {
      "src": "^/(?:weatheros-support\\.html|weatheros-support)/?$",
      "status": 308,
      "headers": {
        "Location": "/weatheros/support"
      }
    },
    {
      "src": "^/(?:weatheros-privacy\\.html|weatheros-privacy)/?$",
      "status": 308,
      "headers": {
        "Location": "/weatheros/privacy"
      }
    },
    {
      "src": "^/evehalo\\.html$",
      "status": 308,
      "headers": {
        "Location": "/evehalo"
      }
    },
    {
      "src": "^/(?:evehalo-support\\.html|evehalo-support)/?$",
      "status": 308,
      "headers": {
        "Location": "/evehalo/support"
      }
    },
    {
      "src": "^/(?:evehalo-privacy\\.html|evehalo-privacy)/?$",
      "status": 308,
      "headers": {
        "Location": "/evehalo/privacy"
      }
    },
    {
      "src": "/evehalo/?",
      "dest": "/server.js"
    },
    {
      "src": "/evehalo/support/?",
      "dest": "/server.js"
    },
    {
      "src": "/evehalo/privacy/?",
      "dest": "/server.js"
    },
    {
      "src": "/evehalo/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "^/website-design/?$",
      "dest": "/website-design.html"
    },
    {
      "src": "/weatheros/?",
      "dest": "/weatheros/index.html"
    },
    {
      "src": "/weatheros/support/?",
      "dest": "/weatheros/support.html"
    },
    {
      "src": "/weatheros/privacy/?",
      "dest": "/weatheros/privacy.html"
    },
    {
      "src": "/(bookings|booking|book|book-otp)/?",
      "dest": "/bookings.html"
    },
    {
      "src": "/api/bookings/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api",
      "dest": "/server.js"
    },
    {
      "src": "/ping",
      "dest": "/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
